{
  "name": "Weather Dashboard API - Python/Flask",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "echo 'Python 3.12 environment ready. Install dependencies with: pip install -r requirements.txt'",
  "forwardPorts": [5000],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests/"]
      }
    }
  },
  "portsAttributes": {
    "5000": {
      "label": "Flask Server",
      "onAutoForward": "notify"
    }
  }
}
