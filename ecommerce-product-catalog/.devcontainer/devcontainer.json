{
  "name": "E-Commerce Product Catalog - Node.js/Express",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "postCreateCommand": "echo 'Node.js 20 environment ready. Install dependencies with: npm install'",
  "forwardPorts": [3000],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true
      }
    }
  },
  "portsAttributes": {
    "3000": {
      "label": "Express Server",
      "onAutoForward": "notify"
    }
  }
}
